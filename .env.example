# Cloudflare SpeedTest DDNS - Environment Configuration
# Copy this file to .env and fill in your actual values

# Cloudflare API Configuration
zone_id=your_zone_id_here
api_token=your_api_token_here

# Domain Configuration
# Single domain: host_name=your.domain.com
# Multiple domains: host_name=a.com,b.com
host_name=your.domain.com
# 推荐只维护一个 A 记录，避免客户端随机命中较差 IP
host_ip_max=1

# WebSocket 真实业务探测（VLESS/WS 等场景强烈建议启用）
# 注意：这是实际 TLS SNI/HTTP Host，不一定等于上面的 DDNS 记录名
ws_probe_enabled=true
ws_probe_host=www.yourdomain.com
ws_probe_path=/your-websocket-path
ws_probe_tls_verify=true
# 只探测延迟排名最前的 N 个候选，控制完整探测耗时
ws_probe_candidate_limit=20

# CloudflareSpeedTest Parameters
# -n: Number of latency test threads (default 200, max 1000)
# -dn: Number of download tests (default 10)
# -sl: Minimum speed threshold in MB/s (default 20)
# -tl: Maximum latency threshold in ms (default 100)
speedtest_para="-n 800 -dn 2 -sl 20 -tl 100"

# Full optimization and lightweight current-IP watchdog schedules
cron=0 * * * *
healthcheck_cron=15,45 * * * *
log_file=/tmp/cloudflare-bestip.log
